# Paddle Payment Gateway Configuration
# You need to create a Paddle account and get these values from your dashboard

# Paddle Vendor ID (your account number - check your account settings or URL)
VITE_PADDLE_VENDOR_ID=your_vendor_id_here

# Paddle Client Side Token (from Developer Tools > Authentication > Client-side tokens tab)
VITE_PADDLE_CLIENT_TOKEN=your_client_side_token_here

# Paddle API Key (from Developer Tools > Authentication > API keys tab)
# This is the key that starts with pdl_sdbx_apikey_... (sandbox) or pdl_live_apikey_... (production)
VITE_PADDLE_API_KEY=your_api_key_here

# Paddle Product Price IDs (created via MCP tools - these are one-time payments)
VITE_PADDLE_PRICE_ID_DAY=pri_01k3keg923y3tjdt9qssz5ych6
VITE_PADDLE_PRICE_ID_WEEK=pri_01k3kegtft7zw2wpfdr6spaxzs
VITE_PADDLE_PRICE_ID_MONTH=pri_01k3keh61xp92zf8brym62a09k

# Instructions:
# 1. Create a Paddle account at https://paddle.com/
# 2. Go to Developer Tools > Authentication to get your tokens
# 3. Create products in Catalog > Products for each featured listing duration:
#    - Featured Listing - 1 Day ($3.00 USD)
#    - Featured Listing - 1 Week ($15.00 USD) 
#    - Featured Listing - 1 Month ($30.00 USD)
# 4. Copy the price IDs from each product
# 5. Copy this file to .env and fill in your actual values
